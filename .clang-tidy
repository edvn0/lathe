# Curated for a C++23 Vulkan/Bullet engine with substantial manual
# lifetime/ownership code (ArenaAllocator placement-new, raw Vulkan handles,
# Bullet rigid body pointers). Checks that would fire constantly on
# deliberate, reviewed patterns here (reinterpret_cast for Vulkan/entt
# handle interop, raw non-owning pointers, literal graphics/physics
# constants) are left disabled rather than suppressed inline everywhere.
#
# Not wired into CI -- this is for local/editor use (clangd picks it up
# automatically) until someone has triaged a first full run's findings.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  performance-*,
  modernize-use-nodiscard,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  readability-container-size-empty,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,

WarningsAsErrors: ''

HeaderFilterRegex: '(include|src)/.*'

FormatStyle: file
