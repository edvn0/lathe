+void _glfwStartWindowDragX11(_GLFWwindow* window, int edges)
+{
+    // _NET_WM_MOVERESIZE directions, indexed by the edge bits (top 1, bottom 2, left 4, right 8).
+    static const long direction[16] = {
+        8, 1, 5, -1, 7, 0, 6, -1, 3, 2, 4, -1, -1, -1, -1, -1
+    };
+
+    const Atom type = XInternAtom(_glfw.x11.display, "_NET_WM_MOVERESIZE", False);
+    if (!type || direction[edges & 15] < 0)
+        return;
+
+    Window root, child;
+    int rootX, rootY, childX, childY;
+    unsigned int mask;
+    XQueryPointer(_glfw.x11.display, window->x11.handle,
+                  &root, &child, &rootX, &rootY, &childX, &childY, &mask);
+
+    XUngrabPointer(_glfw.x11.display, CurrentTime);
+    sendEventToWM(window, type, rootX, rootY, direction[edges & 15], 1, 0);
+    XFlush(_glfw.x11.display);
+}
